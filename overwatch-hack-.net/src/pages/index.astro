---
import BaseLayout from '../layouts/BaseLayout.astro'
import { HomeHero } from '../views/HomeHero'
import { HomeBelowFold } from '../views/HomeBelowFold'
import { SEO } from '../data/site'
import { productCoreJsonLd } from '../lib/seo'
---

<BaseLayout
  seo={SEO.home}
  jsonLdExtra={[productCoreJsonLd()]}
>
  <div class="min-h-screen overflow-x-hidden text-white">
    <HomeHero client:idle />
    <HomeBelowFold client:visible />
  </div>
</BaseLayout>
