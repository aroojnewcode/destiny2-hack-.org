---
import BaseLayout from '../layouts/BaseLayout.astro'
import { ForumsPage } from '../views/ForumsPage'
import { SEO, SITE_URL } from '../data/site'

const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Forum', item: `${SITE_URL}/forums` },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: 'Destiny 2 Hack forum',
    description: SEO.forums.description,
    url: `${SITE_URL}/forums`,
    isPartOf: { '@id': `${SITE_URL}/#website` },
  },
]
---

<BaseLayout seo={SEO.forums} jsonLdExtra={jsonLdExtra}>
  <ForumsPage client:idle />
</BaseLayout>
